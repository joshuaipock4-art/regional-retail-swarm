{
  "openapi": "3.0.0",
  "info": {
    "title": "Autonomous Italian Leather Dropshipping Store API",
    "description": "Interface for the multi-agent autonomous dropshipping store, compatible with IBM watsonx Orchestrate.",
    "version": "1.0.0",
    "contact": {
      "name": "Joshua Ipock",
      "email": "joshuaipock4@gmail.com"
    }
  },
  "servers": [
    {
      "url": "https://online-retail-swarm-app.2aavgmo7wbf3.jp-tok.codeengine.appdomain.cloud"
    }
  ],
  "paths": {
    "/scout-trends": {
      "get": {
        "summary": "Scout Trends",
        "description": "Triggers Agent 0 (Trend Scout) to analyze global market data for top Italian leather trends.",
        "operationId": "scoutTrends",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "all"
            },
            "description": "The category to scout trends for (e.g., bags, shoes, jackets)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/check-inventory": {
      "get": {
        "summary": "Check Inventory",
        "description": "Queries Agent 7 (Inventory) for current stock levels from Italian dropshipping suppliers.",
        "operationId": "checkInventory",
        "parameters": [
          {
            "name": "product_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the product to check."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/process-order": {
      "post": {
        "summary": "Process Order",
        "description": "Coordinates Agent 5 (Fulfillment) to start the dropshipping delivery pipeline.",
        "operationId": "processOrder",
        "parameters": [
          {
            "name": "order_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
